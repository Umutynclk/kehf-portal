rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public portal logo verileri yalnızca okunabilir.
    // Tüm yazma/güncelleme/silme işlemleri Next.js sunucu API'leri (Firebase Admin SDK)
    // üzerinden HttpOnly admin oturumu doğrulandıktan sonra yapılır.
    match /logos/{logoId} {
      allow read: if true;
      allow write: if false;
    }

    // Portal ayarları yalnızca okunabilir; istemciden doğrudan yazma engellidir.
    match /settings/portal {
      allow read: if true;
      allow write: if false;
    }

    // Diğer tüm koleksiyonlara doğrudan erişim engellidir.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
