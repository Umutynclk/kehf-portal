# .env.example — KEHF GROUP Portal (Firebase App Hosting + Vercel Blob)
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# .env.local dosyası git'e commit edilmez.

# ── Firebase Web SDK (istemci yapılandırması) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kehf-d1b3a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kehf-d1b3a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kehf-d1b3a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=239126156142
NEXT_PUBLIC_FIREBASE_APP_ID=1:239126156142:web:947f70dbe251bcf824a77f

# ── Firebase Admin SDK (yalnızca sunucu tarafı) ───────────
FIREBASE_PROJECT_ID=kehf-d1b3a
# Yerel geliştirmede servis hesabı özel anahtarı .env.local dosyasına gömülmez.
# Application Default Credentials (ADC) kullanılır:
#   gcloud auth application-default login --project=kehf-d1b3a
# Alternatif olarak güvenli yerel bir JSON dosya yolu verilebilir:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/adc-or-credentials.json
# (Üretimde Firebase App Hosting ADC otomatik kullanılır.)

# ── Admin Yetkilendirme (yalnızca sunucu, NEXT_PUBLIC_ KULLANMAYIN) ──
# Virgülle ayrılmış yetkili admin e-posta adresleri
ADMIN_EMAILS=admin@kehf.com

# ── Vercel Blob Görsel Depolama ───────────────────────────
BLOB_STORE_ID=store_E4eLQgir33DyB03e
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXX
